+@torch.no_grad()
+def _rel_fro_error(A: torch.Tensor, B: torch.Tensor) -> float:
+    A = A.float()
+    B = B.float()
+    return ((A - B).norm(p="fro") / (A.norm(p="fro") + 1e-12)).item()
