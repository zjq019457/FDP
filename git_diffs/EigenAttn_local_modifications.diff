+    if "opt" in net:
+        layers = model.model.decoder.layers
+        n_layers = len(layers)
+        dummy = nn.Module()
+        dummy.basis_side = basis_side
+        for i in range(n_layers):
+            uq = basis[_find_basis_key(basis, i, "q")].float()
